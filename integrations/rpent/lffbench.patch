new file mode 100644
index 0000000..1c85c25
--- /dev/null
+++ b/robots/lffbench/toolkit.py
@@ -0,0 +1,266 @@
+"""LFF-Bench toolkit: the robot_server v2 commands as RPent structured tools.
+
+Every robot tool forwards one command to the session's ``robot_server``
+(``--style v2``) and nothing else: ``status``, ``observe``, ``move_eef`` and
+``finish`` (ends one attempt), with the server's own arguments. There are no
+file, memory, perception or VLA tools. A tool result is the server's JSON reply
+with its image path lists removed, plus RPent's step index / artifact names;
+the JPEG files the server wrote into ``<sandbox>/obs/`` are attached byte for
+byte (agentview, then wrist; a reply that also starts the next attempt carries
+the reset scene's pair after them).
+
+RPent harness mechanisms kept: stateful tools capture their observation through
+:meth:`get_env_state` into the run's :class:`EnvState` (so the api planner's
+native ``read_image`` can re-open earlier images after history compaction), and
+the planner loop ends through a dedicated tool, ``final_report`` (RPent's
+``finish``, renamed because ``finish`` is the server's attempt command). It is
+refused until the server reports the episode over; attempts, resets, budgets
+and feedback belong to the server.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import time
+import traceback
+from functools import partial
+from pathlib import Path
+from typing import Any
+
+from rpent.dashboard.events import DashboardEventSink
+from rpent.session import EnvState
+from rpent.tools import common
+from rpent.tools.toolkit import Toolkit, ToolResult, readonly
+from rpent.utils.logging import get_logger, get_output_dir
+
+from robots.lffbench.client import RobotServerClient
+
+logger = get_logger("lffbench_toolkit")
+
+#: sha1(JPEG bytes) -> where those bytes came from; read by the transcript logger
+#: to replace base64 payloads in logged requests with file references.
+IMAGE_INDEX: dict[str, dict[str, Any]] = {}
+
+_NO_ARGS = {"type": "object", "properties": {}, "additionalProperties": False}
+_IMAGES = " The two camera images it takes (agentview, then wrist) are attached to the result."
+
+# Wording follows the sandbox README's command list; nothing beyond it.
+TOOLS_SPEC: list[dict[str, Any]] = [
+    {
+        "name": "status",
+        "description": "`./robot status`: task, attempt, budget, current state and images." + _IMAGES,
+        "input_schema": _NO_ARGS,
+    },
+    {
+        "name": "observe",
+        "description": "`./robot observe`: new images and state without moving." + _IMAGES,
+        "input_schema": _NO_ARGS,
+    },
+    {
+        "name": "move_eef",
+        "description": (
+            "`./robot move_eef [x=..] [y=..] [z=..] [yaw=..] [gripper=open|close] [speed=..]`: "
+            "move the grasp point to an absolute target in the same frame as eef_pos (metres; yaw in "
+            "degrees); omitted coordinates keep their current value; the gripper command is executed "
+            "after the motion; speed in m/s (omit = fastest); a target the arm cannot reach is rejected "
+            "and the arm does not move." + _IMAGES
+        ),
+        "input_schema": {
+            "type": "object",
+            "properties": {
+                "x": {"type": "number", "description": "metres"},
+                "y": {"type": "number", "description": "metres"},
+                "z": {"type": "number", "description": "metres"},
+                "yaw": {"type": "number", "description": "degrees"},
+                "gripper": {"type": "string", "enum": ["open", "close"]},
+                "speed": {"type": "number", "description": "m/s (omit = fastest)"},
+            },
+            "additionalProperties": False,
+        },
+    },
+    {
+        "name": "finish",
+        "description": (
+            '`./robot finish reason="..."`: end the current attempt. The result gives the outcome '
+            "and, when another attempt follows, the images of the reset scene."
+        ),
+        "input_schema": {
+            "type": "object",
+            "properties": {"reason": {"type": "string"}},
+            "required": ["reason"],
+            "additionalProperties": False,
+        },
+    },
+]
+
+FINAL_REPORT_SPEC: dict[str, Any] = {
+    "name": "final_report",
+    "description": (
+        "Halts the agent loop. Call it only after a robot tool result has said that the "
+        "episode is over; put your final report in `summary`."
+    ),
+    "input_schema": {
+        "type": "object",
+        "properties": {
+            "status": {"type": "string", "description": "Outcome, e.g. 'success' or 'failure'."},
+            "summary": {"type": "string", "description": "Your final report."},
+        },
+        "required": ["status", "summary"],
+    },
+}
+
+_CAMERAS = ("agentview", "wrist")
+_EPISODE_OVER_MARKERS = ("episode is over", "No attempts left", "Stop now")
+# ToolResult turns these keys into image blocks, in this order.
+_IMAGE_KEYS = ("_image_bytes", "_image_cam_bytes", "_image_nav_bytes", "_image_wrist_bytes")
+
+
+class LffBenchToolkit(Toolkit):
+    """RPent toolkit whose only actuator/sensor is one robot_server v2 session."""
+
+    #: The planner ends only through ``final_report``; a text-only reply is
+    #: answered with the SDK's retry prompt instead of ending the run early.
+    requires_finish_tool = True
+    finish_tool_name = "final_report"
+
+    def __init__(
+        self,
+        *,
+        client: RobotServerClient,
+        dashboard_events: DashboardEventSink,
+        state_output_dir: Path | str | None = None,
+    ) -> None:
+        self._client = client
+        self._episode_over = False
+        state = EnvState(Path(state_output_dir or get_output_dir()))
+        super().__init__(dashboard_events=dashboard_events, state=state, memory=None)
+        for spec in TOOLS_SPEC:
+            self.add_tool(spec["name"], spec, partial(self._robot_command, spec["name"]))
+
+    # ------------------------------------------------------------------
+    # Registration
+    # ------------------------------------------------------------------
+    def _register_common_tools(self) -> None:
+        """Expose only the loop-ending tool (no file / memory I/O)."""
+        self.add_tool("final_report", FINAL_REPORT_SPEC, self._guarded_final_report)
+
+    @readonly
+    def _guarded_final_report(self, status: str, summary: str) -> dict[str, Any]:
+        """Refuse to end the planner loop while the server episode is running."""
+        if not self._episode_over:
+            return {
+                "error": "final_report refused",
+                "reason": (
+                    "The episode is not over yet. Continue with the robot tools; `finish` "
+                    "ends the current attempt. Call `final_report` only after a robot tool "
+                    "result says that the episode is over."
+                ),
+            }
+        return common.finish(status=status, summary=summary)
+
+    # ------------------------------------------------------------------
+    # Tool handlers
+    # ------------------------------------------------------------------
+    def _robot_command(self, cmd: str, **args: Any) -> dict[str, Any]:
+        """Forward one command; never raise (tracebacks carry local paths)."""
+        try:
+            rep = self._client.call(cmd, args)
+        except Exception as exc:  # server down / timeout: report, don't leak
+            logger.error("robot server call %s failed: %s", cmd, traceback.format_exc())
+            return {"ok": False, "error": f"robot server unreachable ({type(exc).__name__})"}
+        replies = [rep]
+        if isinstance(rep.get("attempt_ended"), dict):  # a budget ran out during this command
+            replies.append(rep["attempt_ended"])
+        for r in replies:
+            msg = " ".join(str(r.get(k, "")) for k in ("message", "error"))
+            if any(m in msg for m in _EPISODE_OVER_MARKERS):
+                self._episode_over = True
+        return rep
+
+    def _record_images(
+        self, paths: list[str], *, command: dict[str, Any], state: dict[str, Any], elapsed_s: float
+    ) -> tuple[int, list[str], list[bytes]]:
+        """Store one image pair as an EnvState step; return (step, names, bytes)."""
+        images: list[tuple[str, str, bytes]] = []
+        for cam in _CAMERAS:
+            rel = next((p for p in paths if p.endswith(f"_{cam}.jpg")), None)
+            if rel is not None:
+                images.append((cam, rel, self._client.read_image(rel)))
+        with self._state.record_step(state=state, command=command, elapsed_s=elapsed_s) as step:
+            record = self._state.latest_record()
+            for cam, rel, data in images:
+                name = f"{cam}.jpg"
+                dest = self._state.artifact_path(name, step=step)
+                dest.parent.mkdir(parents=True, exist_ok=True)
+                dest.write_bytes(data)  # exact server bytes, no re-encoding
+                record.artifacts.add(name)
+                IMAGE_INDEX[hashlib.sha1(data).hexdigest()] = {
+                    "sandbox_file": rel,
+                    "artifact": str(dest),
+                    "step": step,
+                    "camera": cam,
+                    "n_bytes": len(data),
+                    "t": time.time(),
+                }
+        return step, [f"{cam}.jpg" for cam, _, _ in images], [data for _, _, data in images]
+
+    def get_env_state(
+        self,
+        *,
+        command: dict[str, Any],
+        result: dict[str, Any],
+        elapsed_s: float,
+    ) -> dict[str, Any]:
+        """Record the server's images as step artifacts and attach them.
+
+        The text the model sees is the server's JSON reply with the image path
+        lists removed (the images themselves are attached), plus RPent's step
+        index and artifact names for ``read_image``.
+        """
+        out = {k: v for k, v in result.items() if k != "images"}
+        nested = result.get("attempt_ended") if isinstance(result.get("attempt_ended"), dict) else None
+        if nested is not None:
+            out["attempt_ended"] = {k: v for k, v in nested.items() if k != "images"}
+        attached: list[bytes] = []
+        for target, source in ((out, result), (out.get("attempt_ended"), nested)):
+            paths = list((source or {}).get("images") or [])
+            if target is None or not paths:
+                continue
+            try:
+                step, names, data = self._record_images(
+                    paths, command=command, state=target, elapsed_s=elapsed_s
+                )
+            except Exception:
+                logger.error("failed to read server images %s: %s", paths, traceback.format_exc())
+                target["images_unavailable"] = True  # harness failure marker, no task information
+                continue
+            target["step"] = step
+            target["artifacts"] = names
+            attached.extend(data)
+        for key, data in zip(_IMAGE_KEYS, attached):
+            out[key] = data
+        return out
+
+    # ------------------------------------------------------------------
+    # Planner-facing API
+    # ------------------------------------------------------------------
+    def execute_tool(self, name: str, input_dict: dict[str, Any]) -> ToolResult:
+        """Dispatch, then label images as JPEG and drop any traceback text."""
+        result = super().execute_tool(name, input_dict)
+        if isinstance(result.result, dict) and "traceback" in result.result:
+            logger.error("tool %s failed: %s", name, result.result["traceback"])
+            cleaned = {k: v for k, v in result.result.items() if k not in ("traceback", "got")}
+            result = ToolResult(name=name, result=cleaned, call_id=result.call_id)
+        for block in result.content_blocks:
+            if block["type"] == "image":
+                block["source"]["media_type"] = "image/jpeg"
+        return result
+
+    @property
+    def episode_over(self) -> bool:
+        """Whether the robot server has reported the episode over."""
+        return self._episode_over
+
+    def solved(self) -> bool:
+        """Task success is judged by the robot server (events.jsonl), not here."""
+        return False
