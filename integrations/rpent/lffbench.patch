+"""LFF-Bench prompt bundle assembly."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+
+from robots.lffbench.prompts import system as system_parts
+from robots.lffbench.prompts import user as user_parts
+from rpent.prompt.utils import Numbered, PromptNode
+
+
+def system_prompt(variables: Mapping[str, object] | None = None) -> PromptNode:
+    """Assemble the system prompt: RPent harness sections + the sandbox README."""
+    return {
+        "ROLE": system_parts.ROLE,
+        "RUNTIME": system_parts.RUNTIME,
+        "ROBOT AND TASK (README)": system_parts.ROBOT_AND_TASK,
+        "RULES": system_parts.RULES,
+        "WORKFLOW": Numbered(system_parts.WORKFLOW),
+        "OUTPUT DISCIPLINE": system_parts.OUTPUT_DISCIPLINE,
+    }
+
+
+def user_prompt(variables: Mapping[str, object] | None = None) -> PromptNode:
+    """Assemble the initial user message."""
+    return {"BEGIN": user_parts.BEGIN}
+
+
+__all__ = ["system_prompt", "user_prompt"]
