index 0000000..61559be
--- /dev/null
+++ b/robots/lffbench/robot_spec.py
@@ -0,0 +1,96 @@
+"""LFF-Bench robot extension: RobotSpec factory, toolkit factory, runtime hooks.
+
+RPent does not own the simulator here. An LFF-Bench ``robot_server`` session
+(``lffbench/scripts/start_robot_session.sh``) is already running; this robot
+borrows it through ``--session <run log dir>/session.json``. There is no memory
+corpus: ``prepare_memory`` is a no-op, so nothing is synced or read.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Any
+
+from robots.lffbench.client import RobotServerClient, read_token
+from robots.lffbench.prompt_bundle import system_prompt, user_prompt
+from rpent.dashboard.events import DashboardEventSink
+from rpent.robots.prompt_bundle import PromptBundle
+from rpent.robots.robot_spec import RobotSpec, RunConfig
+
+
+def get_robot_spec() -> RobotSpec:
+    """Return the LFF-Bench robot identity, prompt bundle, and runner hooks."""
+    return RobotSpec(
+        name="lffbench",
+        prompts=PromptBundle(system=system_prompt, user=user_prompt),
+        add_cli_args=_add_cli_args,
+        parse_config=_parse_config,
+        init_runtime=_init_runtime,
+        prepare_memory=_no_memory,
+    )
+
+
+def get_toolkit(
+    *,
+    runtime_kwargs: dict[str, Any],
+    dashboard_events: DashboardEventSink,
+    config: RunConfig,
+):
+    """Return the toolkit bound to the borrowed robot_server session."""
+    from robots.lffbench.toolkit import LffBenchToolkit
+
+    return LffBenchToolkit(
+        client=runtime_kwargs["client"],
+        dashboard_events=dashboard_events,
+        state_output_dir=config.output_dir,
+    )
+
+
+def _add_cli_args(parser: argparse.ArgumentParser, use_dashboard: bool) -> None:
+    parser.add_argument(
+        "--session",
+        required=not use_dashboard,
+        help="session.json written by lffbench/scripts/start_robot_session.sh",
+    )
+
+
+def _no_memory(args: argparse.Namespace, config: RunConfig) -> None:
+    """No cross-run memory: nothing to sync, nothing exposed."""
+
+
+def _parse_config(args: argparse.Namespace) -> RunConfig:
+    if not args.session:
+        raise ValueError("--session is required")
+    session_path = Path(args.session).expanduser().resolve()
+    sess = json.loads(session_path.read_text())
+    sandbox = Path(sess["sandbox"])
+    readme = (sandbox / "README.md").read_text()
+    if "./robot move_eef" not in readme:
+        raise ValueError(
+            "this toolkit speaks robot_server interface v2 (move_eef / finish); start the "
+            "session with LFF_STYLE=v2 scripts/start_robot_session.sh ..."
+        )
+    output_dir = Path(args.output_dir) if args.output_dir else session_path.parent / "rpent"
+    return RunConfig(
+        recipe_tag="lffbench",
+        output_dir=output_dir,
+        # The README is passed verbatim as a variable (never re-scanned for
+        # placeholders); nothing else about the run reaches the prompts.
+        prompt_vars={"readme": readme.strip()},
+        task_desc={"run": sess.get("run"), "session": str(session_path)},
+    )
+
+
+def _init_runtime(
+    args: argparse.Namespace,
+    output_dir: Path,
+    dashboard_events: DashboardEventSink,
+    components: set[str] | None,
+) -> tuple[list, dict[str, Any]]:
+    """Connect to the already-running robot_server; RPent owns no daemons."""
+    sess = json.loads(Path(args.session).expanduser().read_text())
+    sandbox = Path(sess["sandbox"])
+    client = RobotServerClient(port=sess["port"], token=read_token(sandbox), sandbox=sandbox)
+    return [], {"client": client}
