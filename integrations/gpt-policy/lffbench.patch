index 0000000..b5a16ca
--- /dev/null
+++ b/src/gpt_policy/harness/providers/openai_responses.py
@@ -0,0 +1,386 @@
+"""OpenAI Responses API provider with the Codex provider's thread semantics.
+
+GPT-Policy's default provider runs `codex app-server`: one native thread per robot run, base
+instructions + the tool catalog as system text, and per turn one structured tool selection
+(`outputSchema`, strict JSON schema) at the configured reasoning effort. Older live images stay in the
+thread unless `live_image_window` triggers a refresh with a text-only replay (CodexSession).
+
+`ResponsesClient` reproduces that client interface (`start_thread`, `decide`, `refresh_thread`,
+`_input`, `close`) on the stateless Responses API: the "thread" is the accumulated input list
+(user turns plus the model's own output items, reasoning replayed via encrypted content, store=False),
+so `OpenAIResponsesSession` can reuse CodexSession's context compiler unchanged.
+
+Every request is written to the run transcript in full, with each image replaced by the path and
+sha256 of the file it came from and encrypted reasoning replaced by its length. Transient API failures
+raise AgentOverloadedError so that the host's run loop applies GPT-Policy's retry/backoff (20 retries,
+300 s recovery deadline). Key and endpoint come from OPENAI_API_KEY / OPENAI_BASE_URL and are never
+logged.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import os
+import time
+import uuid
+from typing import Any, Callable, Mapping
+
+from ...input.manifest import ContentPart
+from ..codex import CodexAppServer
+from ..config import AgentConfig
+from ..errors import AgentOverloadedError
+from ..models import AgentDecision, AgentTurn
+from ..usage import model_call
+from .codex import CodexSession
+
+_RETRYABLE_STATUS = {408, 409, 425, 429}
+
+
+class ResponsesClient:
+    """CodexAppServer-compatible client backed by `client.responses.create`."""
+
+    def __init__(
+        self,
+        model: str,
+        effort: str | None = "medium",
+        convert_camera_images_to_jpeg: bool = False,
+        camera_jpeg_quality: int = 85,
+        *,
+        image_detail: str = "auto",
+        reasoning_summary: str | None = "auto",
+        timeout_s: float = 300.0,
+        log: Callable[[dict[str, Any]], None] | None = None,
+        client: Any = None,
+        multi_selection: str = "reject",
+    ) -> None:
+        if multi_selection not in ("reject", "last"):
+            raise ValueError("multi_selection must be 'reject' or 'last' (Codex: execute the final message)")
+        self.model = model
+        self.effort = effort
+        self.convert_camera_images_to_jpeg = convert_camera_images_to_jpeg
+        self.camera_jpeg_quality = camera_jpeg_quality
+        self.image_detail = image_detail
+        self.reasoning_summary = reasoning_summary
+        self.timeout_s = timeout_s
+        self._log = log or (lambda event: None)
+        self._client = client
+        self.instructions: str | None = None
+        self.items: list[dict[str, Any]] = []
+        self.thread_id: str | None = None
+        self.threads = 0
+        self.turns = 0
+        self.last_request_timing: dict[str, float] = {}
+        self.usage_total = {"input_tokens": 0, "cached_tokens": 0, "output_tokens": 0, "reasoning_tokens": 0}
+        self.multi_selection = multi_selection
+        self._image_sources: dict[str, dict[str, Any]] = {}
+
+    # ------------------------------------------------------------------ thread
+    def client(self):
+        if self._client is None:
+            from openai import OpenAI
+
+            key = os.environ.get("OPENAI_API_KEY")
+            if not key:
+                raise RuntimeError("OPENAI_API_KEY is not set")
+            self._client = OpenAI(api_key=key, base_url=os.environ.get("OPENAI_BASE_URL") or None,
+                                  timeout=self.timeout_s, max_retries=0)
+        return self._client
+
+    def start_thread(self, instructions: str, tools: list[dict[str, Any]] | None = None) -> None:
+        """Same system text as CodexAppServer.start_thread: instructions + tool catalog JSON."""
+        if tools:
+            instructions = instructions + "\n\nRobot tool catalog:\n" + json.dumps(tools, ensure_ascii=False)
+        self.instructions = instructions
+        self.items = []
+        self.threads += 1
+        self.thread_id = f"thread-{self.threads}-{uuid.uuid4().hex[:8]}"
+        self._log({"ev": "thread_start", "thread_id": self.thread_id, "model": self.model,
+                   "reasoning_effort": self.effort, "instructions": instructions,
+                   "instructions_sha256": _sha(instructions)})
+
+    def refresh_thread(self, instructions, tools=None):
+        """Release completed visual history; the caller supplies an explicit replay."""
+        self.start_thread(instructions, tools)
+
+    def _input(self, observation, images, content=None, convert_camera_images_to_jpeg=False,
+               camera_jpeg_quality=85):
+        """CodexAppServer._input, remembering which file each image came from (for the logs only)."""
+        items = CodexAppServer._input(observation, images, content, convert_camera_images_to_jpeg,
+                                      camera_jpeg_quality)
+        urls = [item["url"] for item in items if item.get("type") == "image"]
+        for image, url in zip((images or {}).values(), urls[-len(images or {}):] if images else []):
+            data = getattr(image, "data", b"")
+            self._image_sources[url] = {"image_path": getattr(image, "source_path", None),
+                                        "log_copy": getattr(image, "log_copy", None),
+                                        "sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data)}
+        return items
+
+    # ------------------------------------------------------------------ requests
+    def _message(self, items: list[dict[str, Any]]) -> dict[str, Any]:
+        content = []
+        for item in items:
+            if item.get("type") == "text":
+                content.append({"type": "input_text", "text": item["text"]})
+            elif item.get("type") == "image":
+                part = {"type": "input_image", "image_url": item["url"], "detail": item.get("detail", self.image_detail)}
+                content.append(part)
+            else:
+                raise TypeError(f"unsupported input item: {item.get('type')}")
+        return {"role": "user", "content": content}
+
+    def _request(self, message: dict[str, Any], output_schema: dict[str, Any] | None) -> dict[str, Any]:
+        if self.instructions is None:
+            raise RuntimeError("Responses thread has not been started")
+        request: dict[str, Any] = {
+            "model": self.model,
+            "instructions": self.instructions,
+            "input": self.items + [message],
+            "store": False,
+            "include": ["reasoning.encrypted_content"],
+        }
+        reasoning: dict[str, Any] = {}
+        if self.effort:
+            reasoning["effort"] = self.effort
+        if self.reasoning_summary:
+            reasoning["summary"] = self.reasoning_summary
+        if reasoning:
+            request["reasoning"] = reasoning
+        if output_schema is not None:
+            request["text"] = {"format": {"type": "json_schema", "name": "robot_tool_selection",
+                                          "schema": output_schema, "strict": True}}
+        return request
+
+    def _call(self, request: dict[str, Any], kind: str, call: dict[str, Any]) -> tuple[Any, list[dict], str]:
+        self.turns += 1
+        turn = self.turns
+        self._log({"ev": "request", "kind": kind, "turn": turn, "thread_id": self.thread_id,
+                   "request": self._loggable(request)})
+        call["request_started"] = True
+        call["thread_id"] = self.thread_id
+        started = time.perf_counter()
+        try:
+            response = self.client().responses.create(**request)
+        except Exception as exc:  # classify: transient -> host retry with backoff; otherwise fatal
+            elapsed = time.perf_counter() - started
+            code = _retryable_code(exc)
+            self._log({"ev": "api_error", "kind": kind, "turn": turn, "retryable": code is not None,
+                       "error": f"{type(exc).__name__}: {str(exc)[:500]}", "elapsed_s": round(elapsed, 3)})
+            if code is not None:
+                raise AgentOverloadedError(f"OpenAI Responses request failed: {type(exc).__name__}",
+                                           provider="openai_responses", code=code) from exc
+            raise
+        elapsed = time.perf_counter() - started
+        self.last_request_timing["request_elapsed_s"] = elapsed
+        output = [_to_dict(item) for item in (getattr(response, "output", None) or [])]
+        # Like CodexAppServer (last agentMessage with phase None/final_answer): the model occasionally
+        # emits the same selection in two message items, so take the last final message, not a concat.
+        messages = ["".join(part.get("text", "") for part in item.get("content", [])
+                            if part.get("type") == "output_text")
+                    for item in output if item.get("type") == "message"
+                    and item.get("phase") in (None, "final_answer")]
+        text = next((m for m in reversed(messages) if m.strip()), "")
+        usage = _usage(getattr(response, "usage", None))
+        call["raw_usage"] = usage
+        call["usage_final"] = True
+        for key, name in (("input_tokens", "inputTokens"), ("cached_tokens", "cachedInputTokens"),
+                          ("output_tokens", "outputTokens"), ("reasoning_tokens", "reasoningOutputTokens")):
+            self.usage_total[key] += usage.get(name) or 0
+        status = getattr(response, "status", None) or "completed"
+        self._log({"ev": "response", "kind": kind, "turn": turn, "thread_id": self.thread_id,
+                   "response_id": getattr(response, "id", None), "status": status,
+                   "latency_s": round(elapsed, 3), "usage": usage, "output_text": text,
+                   "n_messages": len(messages),
+                   "reasoning_summary": [s.get("text") for item in output if item.get("type") == "reasoning"
+                                         for s in item.get("summary", []) or []],
+                   "output": self._loggable({"input": output})["input"]})
+        if status != "completed" or not text.strip():
+            detail = getattr(response, "incomplete_details", None)
+            raise AgentOverloadedError(f"Responses turn not completed: status={status} detail={detail}",
+                                       provider="openai_responses", code=f"response_{status}")
+        return response, output, text
+
+    def decide(
+        self,
+        observation: str,
+        output_schema: dict[str, Any],
+        images: Mapping[str, Any] | None = None,
+        content: tuple[ContentPart, ...] | None = None,
+        *, replay: list[dict[str, Any]] | None = None,
+    ) -> dict[str, Any]:
+        """Ask for one structured tool selection (same contract as CodexAppServer.decide)."""
+        self.last_request_timing = {}
+        with model_call("openai_responses", self.model) as call:
+            prepare_started = time.perf_counter()
+            items = list(replay or ()) + self._input(observation, images, content,
+                                                     self.convert_camera_images_to_jpeg, self.camera_jpeg_quality)
+            message = self._message(items)
+            request = self._request(message, output_schema)
+            self.last_request_timing["input_prepare_s"] = time.perf_counter() - prepare_started
+            _, output, answer = self._call(request, "decision", call)
+            try:
+                selection = json.loads(answer)
+            except ValueError as exc:
+                raise AgentOverloadedError("Responses output is not JSON", provider="openai_responses",
+                                           code="invalid_output") from exc
+            if not isinstance(selection, dict):
+                raise AgentOverloadedError("Responses tool selection is not a JSON object",
+                                           provider="openai_responses", code="invalid_output")
+            arguments = selection.get("arguments")
+            if isinstance(arguments, str):
+                arguments = json.loads(arguments)
+            if not isinstance(arguments, dict):
+                raise AgentOverloadedError("Responses arguments must be an object", provider="openai_responses",
+                                           code="invalid_output")
+            # Only a completed, parsed turn enters the thread (a failed request leaves no trace in it).
+            self.items += [message] + output
+            decision = {"name": selection.get("name"), "arguments": arguments, "_wire": selection}
+            # GPT-6 Astra sometimes writes a whole plan as several tool selections in intermediate
+            # ("commentary") messages of ONE turn and then imagines their results; Codex semantics execute
+            # only the final message, which turns e.g. a plan ending in `done` into an unexecuted done.
+            # GPT-Policy's contract is one selection per turn, so the host rejects such a turn.
+            names = _selections(output)
+            if len(names) > 1:
+                self._log({"ev": "multi_selection", "turn": self.turns, "selections": names,
+                           "policy": self.multi_selection})
+                if self.multi_selection == "reject":
+                    decision["_host_rejection"] = (
+                        f"this turn contained {len(names)} tool selections ({', '.join(names)}) in separate output "
+                        "messages; the host executes exactly one tool selection per turn and returns its result "
+                        "before your next decision, so none of them was executed and nothing changed since the "
+                        "previous observation")
+            return decision
+
+    def ask_text(self, text: str, *, retries: int = 4) -> str:
+        """One plain-text turn in the same thread (used once, for the final report)."""
+        message = {"role": "user", "content": [{"type": "input_text", "text": text}]}
+        for attempt in range(retries + 1):
+            try:
+                with model_call("openai_responses", self.model) as call:
+                    _, output, answer = self._call(self._request(message, None), "final_report", call)
+                self.items += [message] + output
+                return answer
+            except AgentOverloadedError:
+                if attempt == retries:
+                    raise
+                time.sleep(min(60.0, 5.0 * 2 ** attempt))
+        raise RuntimeError("unreachable")
+
+    def close(self) -> None:
+        client, self._client = self._client, None
+        if client is not None and hasattr(client, "close"):
+            try:
+                client.close()
+            except Exception:
+                pass
+
+    # ------------------------------------------------------------------ logging
+    def _loggable(self, request: dict[str, Any]) -> dict[str, Any]:
+        """Full request with image bytes replaced by their source file and encrypted reasoning elided."""
+        value = copy.deepcopy(request)
+        if "instructions" in value:
+            value["instructions_sha256"] = _sha(value.pop("instructions"))
+        for item in value.get("input", []):
+            if item.get("type") == "reasoning" and item.get("encrypted_content"):
+                item["encrypted_content"] = f"<encrypted reasoning, {len(item['encrypted_content'])} chars>"
+            for part in item.get("content", []) if isinstance(item.get("content"), list) else []:
+                if part.get("type") == "input_image":
+                    url = part.pop("image_url", "")
+                    part.update(self._image_sources.get(url) or {"sha256": _sha(url), "note": "unregistered image"})
+        if "text" in value:
+            value["text_format_sha256"] = _sha(json.dumps(value["text"], sort_keys=True))
+        return value
+
+
+class OpenAIResponsesSession(CodexSession):
+    """CodexSession (live-image window, text-only replay) on the Responses client.
+
+    A failed Responses request leaves nothing in the conversation, so unlike a Codex app-server thread
+    there is no partial turn to discard: by default an overload does not refresh the thread (all
+    earlier images stay). Set refresh_on_overload=True to reproduce the Codex recovery exactly.
+    """
+
+    def __init__(self, config: AgentConfig, model: str, convert_images: bool, jpeg_quality: int, *,
+                 log: Callable[[dict[str, Any]], None] | None = None, image_detail: str = "auto",
+                 timeout_s: float | None = None, refresh_on_overload: bool = False, client: Any = None,
+                 multi_selection: str = "reject") -> None:
+        self.client = ResponsesClient(model, config.effort, convert_images, jpeg_quality, image_detail=image_detail,
+                                      timeout_s=timeout_s or config.timeout_s or 300.0, log=log, client=client,
+                                      multi_selection=multi_selection)
+        self.context = None
+        self.live_image_window = config.live_image_window
+        self._history = []
+        self._live_groups = 0
+        self._recover_thread = False
+        self.refresh_on_overload = refresh_on_overload
+        self.last_context_refresh = None
+        self.last_decision_timing = None
+
+    def decide(self, turn: AgentTurn) -> AgentDecision:
+        try:
+            return super().decide(turn)
+        except AgentOverloadedError:
+            if not self.refresh_on_overload:
+                self._recover_thread = False
+            raise
+
+
+def _selections(output: list[dict[str, Any]]) -> list[str]:
+    """Names of all tool selections written as JSON messages in one turn (any phase)."""
+    names = []
+    for item in output:
+        if item.get("type") != "message":
+            continue
+        text = "".join(part.get("text", "") for part in item.get("content", []) if part.get("type") == "output_text")
+        try:
+            value = json.loads(text)
+        except ValueError:
+            continue  # a plain-text preamble is not a selection
+        if isinstance(value, dict) and isinstance(value.get("name"), str) and "arguments" in value:
+            names.append(value["name"])
+    return names
+
+
+def _retryable_code(exc: Exception) -> str | None:
+    try:
+        import openai
+    except ImportError:  # pragma: no cover
+        return None
+    if isinstance(exc, openai.APITimeoutError):
+        return "timeout"
+    if isinstance(exc, openai.APIConnectionError):
+        return "connection_error"
+    if isinstance(exc, openai.APIStatusError):
+        status = getattr(exc, "status_code", None) or 0
+        if status in _RETRYABLE_STATUS or status >= 500:
+            return f"http_{status}"
+        return None
+    if isinstance(exc, (json.JSONDecodeError, ValueError)) and "JSON" in str(exc):
+        return "invalid_json_body"  # proxy returned a broken body
+    return None
+
+
+def _usage(usage: Any) -> dict[str, Any]:
+    if usage is None:
+        return {}
+    value = _to_dict(usage)
+    inp = value.get("input_tokens_details") or {}
+    out = value.get("output_tokens_details") or {}
+    return {"inputTokens": value.get("input_tokens"), "cachedInputTokens": inp.get("cached_tokens"),
+            "outputTokens": value.get("output_tokens"), "reasoningOutputTokens": out.get("reasoning_tokens"),
+            "totalTokens": value.get("total_tokens")}
+
+
+def _to_dict(item: Any) -> dict[str, Any]:
+    if isinstance(item, dict):
+        return dict(item)
+    if hasattr(item, "model_dump"):
+        return item.model_dump(mode="json", exclude_none=True)
+    if hasattr(item, "to_dict"):
+        return item.to_dict(mode="json")
+    return dict(vars(item))
+
+
+def _sha(text: str) -> str:
+    return hashlib.sha256(text.encode()).hexdigest()
