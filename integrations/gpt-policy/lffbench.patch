diff --git a/scripts/lffbench_audit.py b/scripts/lffbench_audit.py
new file mode 100644
index 0000000..379d497
--- /dev/null
+++ b/scripts/lffbench_audit.py
@@ -0,0 +1,178 @@
+"""Audit one GPT-Policy LFF-Bench run against the unified information contract (docs/04, section 3).
+
+    python scripts/lffbench_audit.py <LOG dir>   (the directory with session.json and gptpolicy_transcript.jsonl)
+
+Checks every request recorded in gptpolicy_transcript.jsonl:
+  * system text = GPT-Policy harness text + the sandbox README verbatim + tool catalog, nothing else
+    that matches the forbidden-content patterns (depth, calibration, segmentation, object poses, paths
+    outside the sandbox, memory, e-mail, task/seed identifiers);
+  * every user text item is one of: the task text (== README TASK section), a GPT-Policy observation
+    JSON whose state / previous_result values all come from robot-server replies (or a host rejection),
+    a "Camera image: agentview|wrist" label, a context-compiler replay marker, or the final-report prompt;
+  * every image is a 512x512 JPEG whose bytes (sha256) equal a file the server wrote (<LOG>/images copy);
+  * every robot-server command belongs to the session's interface (v1: status/move_to/open_gripper/
+    close_gripper/observe/done; v2: status/observe/move_eef/finish/done);
+  * v2 only: no holding/touched/events fields anywhere in what the model sees, and the GPT-Policy part of
+    the system text adds no robot-geometry / axis / table / camera-orientation priors.
+Prints a summary and exits 1 on any violation.
+"""
+import glob
+import hashlib
+import json
+import os
+import re
+import sys
+
+FORBIDDEN = [r"depth", r"point ?cloud", r"pixel_to_world", r"back.?project", r"intrinsic", r"extrinsic",
+             r"segment\(", r"\bsam\b", r"bddl", r"/mnt/", r"/tmp/", r"robotlab", r"lffbench", r"libero",
+             r"MEMORY", r"recipe", r"PROVEN", r"@[a-z0-9-]+\.(com|cn)", r"seed", r"bias",
+             r"hidden", r"privileged", r"locate_point", r"check_path"]
+# extra private strings that must not appear (e.g. your user name): comma-separated regexes in LFF_AUDIT_PRIVATE
+FORBIDDEN += [p for p in os.environ.get("LFF_AUDIT_PRIVATE", "").split(",") if p]
+ALLOWED_CMDS = {"v1": {"status", "move_to", "open_gripper", "close_gripper", "observe", "done"},
+                "v2": {"status", "observe", "move_eef", "finish", "done"}}
+# v2: priors the GPT-Policy text must not add (the README is the only source of geometry)
+V2_PRIORS = [r"\+[xyz]\b", r"-[xyz] ", r"\btable\b", r"forearm", r"camera housing", r"another hand", r"\bbase\b",
+             r"image-(right|left|up|down)", r"looks? (at|down)", r"upward|downward|forward|backward", r"metres? above",
+             r"\b0\.9\d?\b", r"world frame"]
+V2_HIDDEN_KEYS = ("holding", "touched", "events")
+OBS_KEYS = {"instruction", "images", "state", "extra", "previous_result"}
+LABELS = {"Camera image: agentview", "Camera image: wrist"}
+
+
+def canon(value):
+    return json.dumps(value, sort_keys=True, ensure_ascii=False)
+
+
+def strip_images(reply):
+    """What the adapter shows the model: the reply without image paths (also inside attempt_ended)."""
+    reply = {k: v for k, v in reply.items() if k != "images"}
+    if isinstance(reply.get("attempt_ended"), dict):
+        reply["attempt_ended"] = {k: v for k, v in reply["attempt_ended"].items() if k != "images"}
+    return reply
+
+
+def keys_deep(value):
+    if isinstance(value, dict):
+        for k, v in value.items():
+            yield k
+            yield from keys_deep(v)
+    elif isinstance(value, list):
+        for v in value:
+            yield from keys_deep(v)
+
+
+def main(log_dir):
+    events = [json.loads(line) for line in open(os.path.join(log_dir, "gptpolicy_transcript.jsonl"))]
+    session = json.load(open(os.path.join(log_dir, "session.json")))
+    readme = open(os.path.join(session["sandbox"], "README.md")).read()
+    problems = []
+    first = next(e for e in events if e["ev"] == "server_call" and e["cmd"] == "status")
+    task = first["reply"]["task"]  # the README's task section, as the server reports it
+    if task not in readme:
+        problems.append("status.task is not part of the README")
+    style = "v2" if "budget_left" in first["reply"] else "v1"
+
+    replies, reply_pairs = set(), set()
+    for e in events:
+        if e["ev"] == "server_call":
+            if e["cmd"] not in ALLOWED_CMDS[style]:
+                problems.append(f"server command not allowed in {style}: {e['cmd']}")
+            reply = strip_images(e["reply"])
+            replies.add(canon(reply))
+            for part in (reply, reply.get("attempt_ended") or {}):
+                for k, v in part.items():
+                    reply_pairs.add((k, canon(v)))
+
+    server_images = {}
+    for path in glob.glob(os.path.join(log_dir, "images", "*.jpg")):
+        server_images[hashlib.sha256(open(path, "rb").read()).hexdigest()] = path
+
+    instructions = [e for e in events if e["ev"] == "thread_start"]
+    for e in instructions:
+        text = e["instructions"]
+        if readme.rstrip() not in text:
+            problems.append("README is not included verbatim in the instructions")
+        harness = text.replace(readme.rstrip(), "")
+        for pattern in FORBIDDEN + (V2_PRIORS if style == "v2" else []):
+            if re.search(pattern, harness.split("Robot tool catalog:")[0], re.I):
+                problems.append(f"instructions (outside README) match forbidden pattern {pattern!r}")
+
+    n_req = n_img = n_obs = 0
+    for e in events:
+        if e["ev"] != "request":
+            continue
+        n_req += 1
+        for item in e["request"]["input"]:
+            if item.get("role") != "user":
+                continue
+            for part in item["content"]:
+                if part["type"] == "input_image":
+                    n_img += 1
+                    if part.get("sha256") not in server_images:
+                        problems.append(f"request {e['turn']}: image not written by the server ({part.get('image_path')})")
+                    continue
+                text = part["text"]
+                if text in LABELS or text == task:
+                    continue
+                if text.startswith("{"):
+                    obs = json.loads(text)
+                    n_obs += 1
+                    if style == "v2":
+                        hidden = [k for k in keys_deep(obs) if k.startswith(V2_HIDDEN_KEYS)]
+                        if hidden:
+                            problems.append(f"request {e['turn']}: v2 observation contains {sorted(set(hidden))}")
+                    if set(obs) - OBS_KEYS:
+                        problems.append(f"request {e['turn']}: unexpected observation keys {set(obs) - OBS_KEYS}")
+                    if obs.get("instruction") != task:
+                        problems.append(f"request {e['turn']}: instruction differs from README TASK")
+                    for cam in obs.get("images", []):
+                        if set(cam) - {"name", "width", "height"}:
+                            problems.append(f"request {e['turn']}: camera entry has extra fields {cam}")
+                    for k, v in obs.get("state", {}).items():
+                        if (k, canon(v)) not in reply_pairs:
+                            problems.append(f"request {e['turn']}: state {k}={v} not from a server reply")
+                    prev = obs.get("previous_result")
+                    if prev is not None:
+                        result = prev.get("result")
+                        if isinstance(result, dict) and "reports" in result:
+                            for r in result["reports"]:
+                                if canon(r) not in replies:
+                                    problems.append(f"request {e['turn']}: chunk report not a server reply")
+                        elif isinstance(result, dict) and canon(result) in replies:
+                            pass
+                        elif isinstance(prev.get("error"), str) and prev["error"].startswith(("tool_rejected", "motion_not")):
+                            pass
+                        else:
+                            problems.append(f"request {e['turn']}: previous_result not a server reply: {str(prev)[:200]}")
+                    continue
+                if text.startswith(("HISTORICAL EXECUTION RECORD", "END HISTORICAL", "Historical model decision",
+                                    "Final host report", "The host's decision budget")):
+                    if text.startswith("Final host report"):
+                        prev = json.loads(text.split("\n", 2)[1])
+                        if canon(prev["result"]) not in replies and "reports" not in prev["result"]:
+                            problems.append("final report prompt carries a non-server result")
+                    continue
+                problems.append(f"request {e['turn']}: unexpected text item: {text[:120]!r}")
+                for pattern in FORBIDDEN:
+                    if re.search(pattern, text, re.I):
+                        problems.append(f"request {e['turn']}: text matches forbidden pattern {pattern!r}")
+
+    for e in events:  # v2: the model-visible JSON must not carry the hidden signals at all
+        if style == "v2" and e["ev"] == "request":
+            blob = json.dumps(e["request"]["input"], ensure_ascii=False)
+            for key in V2_HIDDEN_KEYS:
+                if re.search(rf'\\?"{key}', blob):
+                    problems.append(f"request {e['turn']}: '{key}' appears in the model input")
+    multi = [e for e in events if e["ev"] == "multi_selection"]
+    print(json.dumps({"style": style, "requests": n_req, "images_sent": n_img, "observations": n_obs,
+                      "multi_selection_turns": len(multi),
+                      "server_calls": sum(e["ev"] == "server_call" for e in events),
+                      "violations": len(problems)}, ensure_ascii=False))
+    for p in sorted(set(problems))[:50]:
+        print("VIOLATION:", p)
+    return 1 if problems else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1]))
