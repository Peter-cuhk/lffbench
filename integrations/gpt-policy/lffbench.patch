+"""Run GPT-Policy against one LFF-Bench robot-server session (simulated robot, OpenAI Responses).
+
+    gpt-policy-lffbench --session <LOG>/session.json [--model gpt-6-astra] [--effort medium]
+
+Pipeline (GPT-Policy's own pieces, see main.py): tool catalog -> output schema + function catalog ->
+base instructions -> provider session (context compiler / self history) -> runtime.runner.run_loop
+(observation JSON with previous_result, one structured tool selection per decision, host validation
+and execution, tool_rejected feedback, overload retry/backoff) -> RunRecorder. Hardware is replaced by
+hardware/lffbench_sim.py; the robot server owns resets, attempts, budget and feedback. The server
+interface (v1 or v2, configs/lffbench/tools_<style>.json) is detected from the first status reply.
+A turn that contains several tool selections (GPT-6 Astra sometimes writes a whole plan as
+"commentary" messages before the final answer) is rejected with a tool_rejected message instead of
+executing only the final selection (--multi-selection last restores the Codex behaviour).
+
+Outputs in the run's LOG directory (the directory of session.json):
+  gptpolicy_transcript.jsonl  every model request (images as file path + sha256) and response, every
+                              robot-server call, start/end records
+  final_report.md             the model's closing report (one extra plain-text turn after the episode)
+  gptpolicy_run_*/            GPT-Policy's own RunRecorder output (events, transcript.json, frames,
+                              usage.json)
+No demonstrations, human videos or target images are used: the first turn's content is the task text.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+import time
+import traceback
+from pathlib import Path
+
+from .harness.config import AgentConfig
+from .harness.lffbench_protocol import FINAL_REPORT_REQUEST, instructions, observation_for
+from .harness.models import AgentContext
+from .harness.protocol import output_schema, tool_schemas
+from .harness.providers.openai_responses import OpenAIResponsesSession
+from .harness.usage import collect_usage
+from .hardware.lffbench_sim import LffBenchCameras, LffBenchSimRobot
+from .input.manifest import TextPart
+from .input.request import RunInput
+from .recording.trace import RunRecorder
+from .runtime.console import RunConsole
+from .runtime import runner
+from .runtime.runner import compact_execution_result, run_loop
+from .settings import RuntimeConfig
+from .tools import ToolExecutor, load_tool_catalog
+
+PROJECT_ROOT = Path(__file__).resolve().parents[2]
+CATALOGS = {style: PROJECT_ROOT / "configs" / "lffbench" / f"tools_{style}.json" for style in ("v1", "v2")}
+ARMS = ("left",)
+
+
+class JsonlLog:
+    def __init__(self, path: Path) -> None:
+        self.path = path
+        self._stream = path.open("a", encoding="utf-8")
+
+    def __call__(self, event: dict) -> None:
+        event = {"t": round(time.time(), 3), **event}
+        self._stream.write(json.dumps(event, ensure_ascii=False, default=str) + "\n")
+        self._stream.flush()
+
+    def close(self) -> None:
+        self._stream.close()
+
+
+def parse_args(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
+    parser.add_argument("--session", required=True, type=Path, help="session.json from start_robot_session.sh")
+    parser.add_argument("--model", default="gpt-6-astra")
+    parser.add_argument("--effort", default="medium")
+    parser.add_argument("--live-image-window", type=int, default=None,
+                        help="GPT-Policy context compiler window (live observation groups); default: off, as in "
+                             "configs/agents/codex.json (all images stay in the thread)")
+    parser.add_argument("--image-detail", default="auto", help="input_image detail (same as gpt_player.py)")
+    parser.add_argument("--max-decisions", type=int, default=240,
+                        help="GPT-Policy decision cap (safety net; the robot server's 40/attempt is the real budget)")
+    parser.add_argument("--request-timeout", type=float, default=300.0)
+    parser.add_argument("--style", default="auto", choices=["auto", "v1", "v2"],
+                        help="robot_server interface; auto = detect from the first status reply")
+    parser.add_argument("--multi-selection", default="reject", choices=["reject", "last"],
+                        help="a turn with several tool selections (commentary messages + final answer): reject it "
+                             "(nothing executed, the model is told) or execute only the final one (Codex behaviour)")
+    parser.add_argument("--model-recovery-timeout", type=float, default=900.0,
+                        help="seconds of consecutive provider failures before the run stops (GPT-Policy default 300; "
+                             "raised because the sub2api relay often drops connections for minutes)")
+    return parser.parse_args(argv)
+
+
+def run(args) -> int:
+    session_path = args.session.expanduser().resolve()
+    log_dir = session_path.parent
+    session = json.loads(session_path.read_text())
+    sandbox, port = session["sandbox"], int(session["port"])
+    token = (Path(sandbox) / "robot").read_text().split('TOKEN = "', 1)[1].split('"', 1)[0]
+    readme = (Path(sandbox) / "README.md").read_text()
+    if not os.environ.get("OPENAI_API_KEY"):
+        raise SystemExit("OPENAI_API_KEY is not set (e.g. set -a; source <lffbench>/.env; set +a)")
+    if args.live_image_window is not None and args.live_image_window < 3:
+        raise SystemExit("--live-image-window must be >= 3 (GPT-Policy's rule) or omitted")
+
+    log = JsonlLog(log_dir / "gptpolicy_transcript.jsonl")
+    display = RunConsole()
+    started = time.time()
+    status, failure, report = "failed", None, None
+    agent = recorder = robot = None
+    with collect_usage():
+        try:
+            robot = LffBenchSimRobot(sandbox, port, token, style=args.style, log=log)
+            first = robot.start()
+            task = robot.task
+            if not task or task not in readme:
+                raise RuntimeError("status.task is not part of the sandbox README")
+            cameras = LffBenchCameras(robot, log_dir=str(log_dir))
+            style = robot.style
+            catalog = load_tool_catalog({"tool_catalog": str(CATALOGS[style])})
+            executor = ToolExecutor(catalog, ARMS, robot, localizer=None)
+            schema = output_schema(robot.dof, ARMS, catalog)
+            functions = tool_schemas(robot.dof, ARMS, catalog)
+            base_instructions = instructions(readme, catalog, robot.dof, ARMS, style=style)
+            agent_config = AgentConfig(type="openai_responses", model=args.model, executable="", effort=args.effort,
+                                       timeout_s=args.request_timeout, live_image_window=args.live_image_window)
+            agent = OpenAIResponsesSession(agent_config, args.model, False, 90, log=log,
+                                           image_detail=args.image_detail, timeout_s=args.request_timeout,
+                                           multi_selection=args.multi_selection)
+            log({"ev": "start", "framework": "GPT-Policy 3a74ed4 + lffbench_sim adapter", "provider": "openai_responses",
+                 "model": args.model, "effort": args.effort, "image_detail": args.image_detail,
+                 "live_image_window": args.live_image_window, "max_decisions": args.max_decisions,
+                 "model_recovery_timeout_s": args.model_recovery_timeout, "style": style,
+                 "multi_selection": args.multi_selection,
+                 "base_url_set": bool(os.environ.get("OPENAI_BASE_URL")), "session": session,
+                 "first_status": first, "output_schema": schema, "function_catalog": functions})
+            runtime = RuntimeConfig(robot_model="lffbench-sim", interface="lffbench-robot-server", right_interface="",
+                                    gripper_open_readout=0.0, camera_width=512, camera_height=512,
+                                    convert_camera_images_to_jpeg=False, camera_jpeg_quality=90, trajectory_hz=20.0,
+                                    task_name="lffbench", record_dir=log_dir / "gptpolicy_run",
+                                    max_decisions=args.max_decisions)
+            run_input = RunInput(instruction=task, model=args.model, content=(TextPart(task),))
+            recorder = RunRecorder(log_dir / "gptpolicy_run", {
+                "instruction": task, "task_name": "lffbench", "max_decisions": args.max_decisions,
+                "model": args.model, "agent": {"type": "openai_responses", "model": args.model, "effort": args.effort,
+                                               "live_image_window": args.live_image_window},
+                "input": run_input.record(), "robot_model": runtime.robot_model, "session": session})
+            recorder.write("protocol", {"output_schema": schema, "tool_catalog": functions,
+                                        "base_instructions": base_instructions, "cameras": cameras.describe()})
+            display.header(task, args.model, "lffbench-sim", recorder.root, args.max_decisions)
+            agent.start(AgentContext(base_instructions, functions, schema))
+            runner.MODEL_RECOVERY_TIMEOUT_S = args.model_recovery_timeout
+            status = run_loop(runtime, run_input, robot, cameras, cameras, agent, executor, recorder,
+                              observation_for(style), display=display)
+            if robot.last_tool is not None and (robot.episode_finished or status == "budget_exhausted"):
+                previous = json.dumps({"tool": robot.last_tool,
+                                       "result": compact_execution_result(robot.last_result)}, ensure_ascii=False)
+                prompt = ("Final host report for your last tool selection:\n" + previous + "\n\n" + FINAL_REPORT_REQUEST
+                          if robot.episode_finished else
+                          "The host's decision budget is exhausted. " + FINAL_REPORT_REQUEST)
+                report = agent.client.ask_text(prompt)
+                (log_dir / "final_report.md").write_text(report.rstrip() + "\n", encoding="utf-8")
+                log({"ev": "final_report", "text": report})
+        except BaseException as exc:  # record and stop; the robot server keeps its own events.jsonl
+            failure = f"{type(exc).__name__}: {exc}"
+            status = "interrupted" if isinstance(exc, KeyboardInterrupt) else "failed"
+            log({"ev": "abort", "error": failure, "traceback": traceback.format_exc()[-4000:]})
+            display.message(f"Run stopped: {failure}", "red")
+        finally:
+            usage = agent.client.usage_total if agent is not None else None
+            if agent is not None:
+                agent.close()
+            final_dir = None
+            if recorder is not None:
+                recorder.write("execution_finished", {"status": status, "error": failure})
+                try:
+                    final_dir = recorder.close(status, failure)
+                except Exception as exc:
+                    log({"ev": "recorder_close_error", "error": repr(exc)})
+            summary = {
+                "ev": "end", "status": status, "error": failure,
+                "episode_finished": bool(robot and robot.episode_finished),
+                "server_commands": robot.server_commands if robot else None,
+                "model_turns": agent.client.turns if agent is not None else None,
+                "usage_total": usage, "wall_s": round(time.time() - started, 1),
+                "gptpolicy_run_dir": str(final_dir) if final_dir else None,
+                "final_report": bool(report),
+            }
+            log(summary)
+            log.close()
+            print(json.dumps(summary, ensure_ascii=False), flush=True)
+    return 0 if status == "completed" and report else 1
+
+
+def main(argv=None) -> None:
+    sys.exit(run(parse_args(argv)))
+
+
+if __name__ == "__main__":
+    main()
