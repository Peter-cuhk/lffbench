index 0000000..7e6546f
--- /dev/null
+++ b/src/gpt_policy/harness/lffbench_protocol.py
@@ -0,0 +1,148 @@
+"""GPT-Policy protocol text for the simulated LFF-Bench robot.
+
+`instructions()` keeps the structure of harness/protocol.py:instructions(): role line, robot
+description, output contract, tool prompts, state semantics and GPT-Policy's general control guidance
+(orientation retention, notes, efficient motion, grasp sequence, release verification, persistence).
+Under the LFF-Bench information contract the robot/task description is the sandbox README verbatim,
+so it replaces the ARX/YAM calibration notes and scene safety notes. Sentences that refer to things
+this backend does not have (IK and check_path, joint velocities/torques, settling reports, planned
+TCP points, a human labelling the outcome, insertion-specific completion rules) are removed or reworded
+to the robot server's equivalents; nothing task-specific is added.
+
+`observation()` keeps GPT-Policy's per-turn JSON observation (instruction, images, state, extra.env_step,
+previous_result), filled only with what the robot server returned.
+
+Two texts exist, one per robot_server interface. v1 is kept byte-identical to the text used for the
+first smoke test and batch full1. v2 (formal evaluation) uses the minimal v2 README and additionally
+drops every sentence of GPT-Policy's general guidance that implies robot geometry (forearms, camera
+housings, a second hand, table clearance) so that the README stays the only source of priors.
+"""
+
+from __future__ import annotations
+
+import json
+from typing import Any
+
+from ..tools.catalog import ToolCatalog
+from .protocol import _model_numbers
+
+STATE_KEYS = {
+    "v1": ("eef_pos", "eef_yaw_deg", "gripper", "gripper_width_m", "holding_object"),
+    "v2": ("eef_pos", "eef_yaw_deg", "gripper_width_m", "budget_left"),
+}
+
+HARNESS_MAPPING = HARNESS_MAPPING_V1 = """How this harness relates to the README: you do not run `./robot` yourself and you have no file, shell or network access. Each turn you return one tool selection and the host translates it into the README's robot commands: move_to -> `./robot move_to x=.. y=.. z=.. yaw=.. [speed=..]`; move_eef_chunk -> one `./robot move_to` per waypoint, in order; set_gripper -> `./robot open_gripper` or `./robot close_gripper`; observe -> `./robot observe`; done and give_up -> `./robot done reason="..."`. Each of these robot commands counts toward the README's per-attempt command limit. After every selection the host returns the robot's report as observation.previous_result and attaches the camera images taken after the action (agentview, wrist) to the observation, so there are no image files to read. Text that the README asks you to write before a command goes into the note (or the done/give_up text) of your next tool selection."""
+
+
+def instructions(readme: str, catalog: ToolCatalog, dof: int = 7, arms: tuple[str, ...] = ("left",),
+                 style: str = "v2") -> str:
+    if style == "v2":
+        return instructions_v2(readme, catalog, dof, arms)
+    return instructions_v1(readme, catalog, dof, arms)
+
+
+def instructions_v1(readme: str, catalog: ToolCatalog, dof: int = 7, arms: tuple[str, ...] = ("left",)) -> str:
+    tool_text = catalog.prompt_catalog(dof, arms)
+    return f"""You are a robot controller using the GPT-Policy harness. You control the simulated robot arm described in the README below; only one arm is controlled.
+
+README (robot and task description, verbatim):
+<<<README
+{readme.rstrip()}
+README>>>
+
+{HARNESS_MAPPING}
+
+Return exactly one tool selection per turn: {{"name": "...", "arguments": {{...}}}}. No Markdown or text outside this object. The host executes the full motion segment, then supplies a fresh observation.
+
+Tools:
+{tool_text}
+
+observation.state is the robot's latest proprioceptive report (end-effector position, yaw, gripper, whether an object is held), exactly as the robot reports it. previous_result is the robot's report for your previous tool selection, or the host's rejection if it was not executed.
+
+Orientation retention and reachability: For position-only adjustments, keep the last commanded yaw. The configured workspace is not a measured reachability boundary; an in-range point may be unreachable. The robot reports whether each target was reached.
+
+Every motion tool requires a note: 1-2 short Chinese sentences, usually 20-60 characters, stating current evidence and the next purpose. Keep failure causes when relevant; do not repeat coordinate arrays, history, tool mechanics or general rules. Use only the selected tool's arguments. Follow its schema for omitted and nullable fields. Camera images are supplied through observation.images and actual image inputs.
+
+Efficient motion: Prefer move_eef_chunk for clear, contact-free paths that need no intermediate observation. Do not split them into many decisions. Stop to observe at contact, gripper changes, occlusion or tracking anomalies; efficiency never justifies skipping verification.
+
+Grasp sequence: Approach and align, inspect fresh images and state, then call set_gripper separately. Before closure, consider wrist close-ups, the agentview overview and the reported state together. A submitted target does not prove arrival.
+Check fingertips, wrists, camera housings, forearms and table clearance in fresh views. Do not advance contact without verified stabilization and clearance.
+
+Release verification: Before releasing or regrasping, verify that the intended surface or another hand reliably supports the entire object. Observe after release and before withdrawing. A fully-open command does not prove that a wide object detached. If the object stays fixed relative to the fingers or the destination still appears empty, keep it reliably supported by the intended surface or container while disengaging the fingers. Do not lift a still-trapped object away and report completion.
+
+Persistence: One failed action, tool rejection, missed grasp, occluded target or uncertain result does not establish impossibility. Diagnose from fresh images, reported state and previous_result, then try safe alternatives in viewpoint, approach, grasp, orientation, path or step size and verify each result. Call done only when the physical goal is established. Do not call give_up while reasonable safe strategies remain. Consider meaningfully different recoveries; give_up requires evidence that the task cannot be completed or further attempts would violate safety constraints. In reason, list attempted strategies and the evidence preventing further progress.
+"""
+
+
+HARNESS_MAPPING_V2 = """How this harness relates to the README: you do not run `./robot` yourself and you have no file, shell or network access. Each turn you return one tool selection and the host translates it into the README's robot commands: move_eef -> one `./robot move_eef` with the non-null fields of target; move_eef_chunk -> one `./robot move_eef` per waypoint, in order; observe -> `./robot observe`; done and give_up -> `./robot finish reason="..."`. move_eef, every chunk waypoint and observe each count as one robot command toward the README's per-attempt command budget. After every selection the host returns the robot's reply as observation.previous_result (without the image paths) and attaches the camera images taken after it (agentview, wrist) to the observation, so there are no image files to read."""
+
+
+def instructions_v2(readme: str, catalog: ToolCatalog, dof: int = 7, arms: tuple[str, ...] = ("left",)) -> str:
+    tool_text = catalog.prompt_catalog(dof, arms)
+    return f"""You are a robot controller using the GPT-Policy harness. You control the simulated robot arm described in the README below; only one arm is controlled.
+
+README (robot and task description, verbatim):
+<<<README
+{readme.rstrip()}
+README>>>
+
+{HARNESS_MAPPING_V2}
+
+Return exactly one tool selection per turn: {{"name": "...", "arguments": {{...}}}}. No Markdown or text outside this object. The host executes the full motion segment, then supplies a fresh observation.
+
+Tools:
+{tool_text}
+
+observation.state holds the state fields of the robot's latest reply (eef_pos, eef_yaw_deg, gripper_width_m, budget_left), exactly as the robot reports them. previous_result is the robot's reply to your previous tool selection, or the host's rejection if it was not executed.
+
+Orientation retention and reachability: For position-only adjustments, keep the last commanded yaw. An accepted target is not proof of arrival; check how far the gripper stopped from it.
+
+Every motion tool requires a note: 1-2 short Chinese sentences, usually 20-60 characters, stating current evidence and the next purpose. Keep failure causes when relevant; do not repeat coordinate arrays, history, tool mechanics or general rules. Use only the selected tool's arguments. Follow its schema for omitted and nullable fields. Camera images are supplied through observation.images and actual image inputs.
+
+Efficient motion: Prefer move_eef_chunk for clear, contact-free paths that need no intermediate observation. Do not split them into many decisions. Stop to observe at contact, gripper changes, occlusion or tracking anomalies; efficiency never justifies skipping verification.
+
+Grasp sequence: Approach and align, inspect fresh images and state, then change the gripper in a separate selection. Before closure, consider the wrist image, the agentview image and the reported state together. A submitted target does not prove arrival. Do not advance contact without verified stabilization and clearance in fresh views.
+
+Release verification: Before releasing or regrasping, verify that the intended surface reliably supports the entire object. Observe after release and before withdrawing. A fully-open command does not prove that a wide object detached. If the object stays fixed relative to the fingers or the destination still appears empty, keep it reliably supported by the intended surface or container while disengaging the fingers. Do not lift a still-trapped object away and report completion.
+
+Persistence: One failed action, tool rejection, missed grasp, occluded target or uncertain result does not establish impossibility. Diagnose from fresh images, reported state and previous_result, then try safe alternatives in viewpoint, approach, grasp, orientation, path or step size and verify each result. Call done only when the physical goal is established. Do not call give_up while reasonable safe strategies remain. Consider meaningfully different recoveries; give_up requires evidence that the task cannot be completed or further attempts would violate safety constraints. In reason, list attempted strategies and the evidence preventing further progress.
+"""
+
+
+def observation_for(style: str):
+    """GPT-Policy's observation function with the state fields of the given server interface."""
+    keys = STATE_KEYS[style]
+
+    def _observation(instruction, state, cameras, previous=None, step=0):
+        return observation(instruction, state, cameras, previous, step, state_keys=keys)
+
+    return _observation
+
+
+def observation(
+    instruction: str,
+    state: dict[str, Any],
+    cameras: list[dict[str, Any]],
+    previous: str | None = None,
+    step: int = 0,
+    *,
+    state_keys: tuple[str, ...] = STATE_KEYS["v1"],
+) -> str:
+    """GPT-Policy's JSON observation; state holds only the server-reported state fields."""
+    payload: dict[str, Any] = {
+        "instruction": instruction,
+        "images": [{key: camera[key] for key in ("name", "width", "height") if key in camera}
+                   for camera in cameras],
+        "state": {key: state[key] for key in state_keys if key in state},
+        "extra": {"env_step": step},
+    }
+    if previous is not None:
+        payload["previous_result"] = json.loads(previous)
+    return json.dumps(_model_numbers(payload), ensure_ascii=False, separators=(",", ":"))
+
+
+FINAL_REPORT_REQUEST = (
+    "The robot server reports that the episode is over; no further robot commands will be executed. "
+    "Reply in plain text, not as a tool selection, with a short report: what you did (key commands and "
+    "parameter values), what you observed, any feedback you got, and how you changed your approach."
+)
diff --git a/src/gpt_policy/harness/providers/openai_responses.py b/src/gpt_policy/harness/providers/openai_responses.py
