new file mode 100644
index 0000000..241b740
--- /dev/null
+++ b/scripts/lffbench_dryrun.py
@@ -0,0 +1,80 @@
+"""Dry run of gpt-policy-lffbench with a scripted fake Responses client (no API calls, no cost).
+
+    OPENAI_API_KEY=dummy python scripts/lffbench_dryrun.py <LOG>/session.json [v2|v1]
+
+Uses (and consumes) a real robot-server session. v2 script: a move_eef_chunk, an unreachable target
+(server rejection), an argument set the adapter rejects, a gripper-only move_eef, observe, a turn with
+two selections (commentary + final; host rejects it), one injected connection error (host retry),
+done / give_up across all k attempts and the final-report turn. Then run scripts/lffbench_audit.py <LOG>.
+"""
+import json
+import sys
+from types import SimpleNamespace as NS
+
+from gpt_policy import lffbench_main
+from gpt_policy.harness.providers import openai_responses as P
+import gpt_policy.runtime.runner as R
+
+W = dict(x=None, y=None, z=None, yaw=None, gripper=None, speed=None)
+SCRIPTS = {
+    "v2": [
+        [{"name": "move_eef_chunk", "arguments": {"poses": [dict(W, x=0.0, y=0.0, z=1.10, yaw=0.0),
+                                                           dict(W, z=1.05, speed=0.3)], "note": "先移动"}}],
+        [{"name": "move_eef", "arguments": {"target": dict(W, z=9.0), "note": "越界测试"}}],
+        [{"name": "move_eef", "arguments": {"poses": [], "note": "错参数测试"}}],
+        [{"name": "move_eef", "arguments": {"target": dict(W, gripper="close"), "note": "只闭合"}}],
+        [{"name": "observe", "arguments": {"note": "看看"}}],
+        [{"name": "move_eef", "arguments": {"target": dict(W, z=1.0), "note": "计划1"}},
+         {"name": "done", "arguments": {"summary": "imagined", "hindsight": "none"}}],
+        [{"name": "done", "arguments": {"summary": "dry run attempt", "hindsight": "none"}}],
+        [{"name": "give_up", "arguments": {"reason": "dry run give up", "hindsight": "none"}}],
+        [{"name": "done", "arguments": {"summary": "dry run last", "hindsight": "none"}}],
+    ],
+    "v1": [
+        [{"name": "move_eef_chunk", "arguments": {"poses": [{"x": 0.0, "y": 0.0, "z": 1.10, "yaw": 0, "speed": None},
+                                                           {"x": 0.05, "y": 0.0, "z": 1.05, "yaw": 0, "speed": 0.3}],
+                                                 "note": "先移动"}}],
+        [{"name": "set_gripper", "arguments": {"gripper": "close", "note": "闭合"}}],
+        [{"name": "done", "arguments": {"summary": "dry run attempt", "hindsight": "none"}}],
+        [{"name": "give_up", "arguments": {"reason": "dry run give up", "hindsight": "none"}}],
+        [{"name": "done", "arguments": {"summary": "dry run last", "hindsight": "none"}}],
+    ],
+}
+
+
+def main(session, style="v2"):
+    script = SCRIPTS[style]
+    calls = {"n": 0, "fail_once": True}
+
+    class FakeResponses:
+        def create(self, **req):
+            assert req["store"] is False and "tools" not in req
+            if calls["fail_once"] and calls["n"] == 2:
+                calls["fail_once"] = False
+                import httpx2
+                import openai
+                raise openai.APIConnectionError(request=httpx2.Request("POST", "http://x"))
+            if "text" not in req:
+                selections = None
+            else:
+                selections = script[min(calls["n"], len(script) - 1)]
+                calls["n"] += 1
+            out = [{"type": "reasoning", "id": f"rs_{calls['n']}", "summary": [{"type": "summary_text", "text": "t"}],
+                    "encrypted_content": "x" * 100}]
+            texts = [("final_answer", "FINAL REPORT (fake)")] if selections is None else (
+                [("commentary", json.dumps(s)) for s in selections[:-1]] + [("final_answer", json.dumps(selections[-1]))])
+            for i, (phase, text) in enumerate(texts):
+                out.append({"type": "message", "id": f"msg_{calls['n']}_{i}", "role": "assistant", "phase": phase,
+                            "status": "completed", "content": [{"type": "output_text", "text": text, "annotations": []}]})
+            return NS(id=f"resp_{calls['n']}", status="completed", output=out, incomplete_details=None,
+                      usage={"input_tokens": 1000, "input_tokens_details": {"cached_tokens": 10},
+                             "output_tokens": 50, "output_tokens_details": {"reasoning_tokens": 20}, "total_tokens": 1050})
+
+    fake = NS(responses=FakeResponses(), close=lambda: None)
+    P.ResponsesClient.client = lambda self: fake
+    R.MODEL_RETRY_DELAYS_S = tuple(0.1 for _ in range(20))
+    return lffbench_main.run(lffbench_main.parse_args(["--session", session, "--style", style]))
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else "v2"))
diff --git a/src/gpt_policy/hardware/lffbench_sim.py b/src/gpt_policy/hardware/lffbench_sim.py
new file mode 100644
index 0000000..75173ed
--- /dev/null
+++ b/src/gpt_policy/hardware/lffbench_sim.py
@@ -0,0 +1,320 @@
+"""Simulated-robot adapter for the LFF-Bench robot server (same layer as the ARX/YAM adapters).
+
+The LFF-Bench robot server (lffbench/agent/robot_server.py) owns the MuJoCo simulation, the task
+instance, the attempt protocol (k attempts, per-attempt budgets, automatic reset and outcome feedback)
+and the rollout video. This adapter never touches the simulator: every executed tool becomes one or
+more HTTP calls `POST /call {"cmd", "args"}` (X-Token) to that server, i.e. exactly the
+`./robot <cmd> key=value ...` commands of the sandbox README. Two server interfaces exist:
+
+  v2 (`--style v2`, formal evaluation from 2026-10-07 evening; LIBERO-Agent / RoboDojo-aligned)
+    move_eef        -> one `move_eef [x y z yaw gripper speed]` (null fields are left out)
+    move_eef_chunk  -> one `move_eef` per waypoint, in order (each counts toward the server budget)
+    observe         -> `observe`
+    done / give_up  -> `finish reason="..."`
+  v1 (first smoke test / batch full1)
+    move_to -> `move_to`; move_eef_chunk -> one `move_to` per waypoint; set_gripper -> `open_gripper` |
+    `close_gripper`; observe -> `observe`; done / give_up -> `done reason="..."`
+
+plus a single `status` (free, not counted) at start for the first images and state.
+
+What the agent can see is only what the server returns: each reply (minus the sandbox-relative image
+paths, which are replaced by the attached images) and the two JPEG files (agentview, wrist) the server
+wrote into <sandbox>/obs/, passed through byte for byte. There is no depth, no camera calibration, no
+object pose and no IK/robot model on this side: GPT-Policy's own IK preview (`check_path`) and pixel
+localisation (`locate_point`) are not available for this backend.
+"""
+
+from __future__ import annotations
+
+import glob
+import json
+import math
+import os
+import time
+import urllib.request
+from copy import deepcopy
+from dataclasses import dataclass
+from typing import Any, Callable
+
+from .camera import CapturedImage
+
+# Server-reported state fields that form GPT-Policy's observation.state, per interface style.
+STATE_KEYS = {
+    "v1": ("eef_pos", "eef_yaw_deg", "gripper", "gripper_width_m", "holding_object"),
+    "v2": ("eef_pos", "eef_yaw_deg", "gripper_width_m", "budget_left"),
+}
+CAMERAS = ("agentview", "wrist")
+# Same end-of-episode detection as lffbench/scripts/gpt_player.py.
+FINISHED_MARKERS = ("episode is over", "No attempts left", "Stop now")
+V2_TARGET_KEYS = ("x", "y", "z", "yaw", "gripper", "speed")
+
+
+@dataclass(frozen=True)
+class SimImage(CapturedImage):
+    """A server-written observation JPEG; `source_path` is only for logs, never sent to the model."""
+
+    source_path: str | None = None
+    log_copy: str | None = None  # the server's persistent copy in <LOG>/images/ (same bytes)
+
+
+class RobotServerClient:
+    """Minimal client of the robot server's localhost HTTP interface (proxy disabled)."""
+
+    def __init__(self, port: int, token: str, timeout_s: float = 900.0) -> None:
+        self.url = f"http://127.0.0.1:{int(port)}/call"
+        self.token = token
+        self.timeout_s = timeout_s
+        self._opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+
+    def call(self, cmd: str, args: dict[str, Any] | None = None) -> Any:
+        body = json.dumps({"cmd": cmd, "args": args or {}}).encode()
+        request = urllib.request.Request(self.url, data=body, headers={
+            "Content-Type": "application/json", "X-Token": self.token})
+        with self._opener.open(request, timeout=self.timeout_s) as response:
+            raw = response.read().decode()
+        try:
+            return json.loads(raw)
+        except ValueError:
+            return {"text": raw}
+
+
+def detect_style(status: dict[str, Any]) -> str:
+    """v2 status replies carry budget_left; v1 ones carry the protocol / holding fields."""
+    return "v2" if "budget_left" in status else "v1"
+
+
+class LffBenchSimRobot:
+    """GPT-Policy robot facade (state / execute / return_home / cancel / close) over the robot server."""
+
+    backend = "lffbench_sim"
+    dof = 7  # only used for GPT-Policy's "{dof}" templates, never shown to the model here.
+
+    def __init__(self, sandbox: str, port: int, token: str, *, style: str = "auto",
+                 log: Callable[[dict[str, Any]], None] | None = None, timeout_s: float = 900.0) -> None:
+        if style not in ("auto", "v1", "v2"):
+            raise ValueError(f"unknown robot_server style {style!r}")
+        self.sandbox = os.path.abspath(sandbox)
+        self.client = RobotServerClient(port, token, timeout_s)
+        self.style = style
+        self._log = log or (lambda event: None)
+        self._state: dict[str, Any] = {}
+        self.latest_images: list[str] = []
+        self.task: str | None = None
+        self.episode_finished = False
+        self.server_commands = 0  # commands sent other than status
+        self.last_tool: str | None = None
+        self.last_result: Any = None
+
+    # ------------------------------------------------------------------ server I/O
+    def _send(self, cmd: str, args: dict[str, Any] | None = None) -> dict[str, Any]:
+        started = time.time()
+        reply = self.client.call(cmd, args or {})
+        if not isinstance(reply, dict):
+            reply = {"ok": False, "error": f"unexpected reply type {type(reply).__name__}"}
+        if cmd != "status":
+            self.server_commands += 1
+        self._log({"ev": "server_call", "cmd": cmd, "args": args or {}, "reply": reply,
+                   "server_s": round(time.time() - started, 3)})
+        return self._absorb(reply)
+
+    def _absorb(self, reply: dict[str, Any]) -> dict[str, Any]:
+        """Replace image paths by attached images and keep the latest server-reported state.
+
+        v2 can end an attempt inside a move_eef reply (motion budget used up): the nested
+        `attempt_ended` reply then carries the reset scene's images and state, which are newer.
+        """
+        report = dict(reply)
+        parts = [report]
+        if isinstance(report.get("attempt_ended"), dict):
+            report["attempt_ended"] = dict(report["attempt_ended"])
+            parts.append(report["attempt_ended"])
+        for part in parts:
+            paths = part.pop("images", None) or []
+            if paths:
+                self.latest_images = [os.path.join(self.sandbox, path) for path in paths]
+            for key in STATE_KEYS[self.style if self.style != "auto" else "v2"]:
+                if key in part:
+                    self._state[key] = part[key]
+            message = f"{part.get('message', '')} {part.get('error', '')}"
+            if any(marker in message for marker in FINISHED_MARKERS):
+                self.episode_finished = True
+        return report
+
+    def start(self) -> dict[str, Any]:
+        """`./robot status` (not counted by the server): task text, first images and state."""
+        status = self.client.call("status")
+        if self.style == "auto":
+            self.style = detect_style(status if isinstance(status, dict) else {})
+        self._log({"ev": "server_call", "cmd": "status", "args": {}, "reply": status, "style": self.style})
+        status = self._absorb(status)
+        self.task = status.get("task")
+        return status
+
+    # ------------------------------------------------------------------ GPT-Policy robot facade
+    def state(self) -> dict[str, Any]:
+        return deepcopy(self._state)
+
+    def execute(self, name: str, arguments: dict[str, Any]) -> dict[str, Any]:
+        if self.episode_finished:
+            raise ValueError("the episode is over; no further robot commands are executed")
+        result = self._execute_v2(name, arguments) if self.style == "v2" else self._execute_v1(name, arguments)
+        self.last_tool, self.last_result = name, result
+        return result
+
+    def _execute_v2(self, name: str, arguments: dict[str, Any]) -> dict[str, Any]:
+        if name == "move_eef":
+            return self._send("move_eef", _eef_target(arguments.get("target"), "move_eef.target"))
+        if name == "move_eef_chunk":
+            return self._chunk("move_eef", arguments.get("poses"), _eef_target)
+        if name == "observe":
+            return self._send("observe")
+        if name == "done":
+            return self._send("finish", {"reason": _text(arguments.get("summary"), "done.summary")})
+        if name == "give_up":
+            return self._send("finish", {"reason": "give_up: " + _text(arguments.get("reason"), "give_up.reason")})
+        raise ValueError(f"tool not supported by the simulated robot: {name}")
+
+    def _execute_v1(self, name: str, arguments: dict[str, Any]) -> dict[str, Any]:
+        if name == "move_to":
+            return self._send("move_to", _waypoint(arguments.get("target"), "move_to.target"))
+        if name == "move_eef_chunk":
+            return self._chunk("move_to", arguments.get("poses"), _waypoint)
+        if name == "set_gripper":
+            value = arguments.get("gripper")
+            if value not in ("open", "close"):
+                raise ValueError('set_gripper.gripper must be "open" or "close"')
+            return self._send("open_gripper" if value == "open" else "close_gripper")
+        if name == "observe":
+            return self._send("observe")
+        if name == "done":
+            return self._send("done", {"reason": _text(arguments.get("summary"), "done.summary")})
+        if name == "give_up":
+            return self._send("done", {"reason": "give_up: " + _text(arguments.get("reason"), "give_up.reason")})
+        raise ValueError(f"tool not supported by the simulated robot: {name}")
+
+    def _chunk(self, cmd: str, poses: Any, convert: Callable[[Any, str], dict[str, Any]]) -> dict[str, Any]:
+        if not isinstance(poses, list) or not poses:
+            raise ValueError("move_eef_chunk.poses must be a non-empty waypoint list")
+        # Validate the whole path before sending anything (GPT-Policy rejects a chunk before execution).
+        waypoints = [convert(pose, f"move_eef_chunk.poses[{i}]") for i, pose in enumerate(poses)]
+        reports, stopped = [], None
+        for index, waypoint in enumerate(waypoints):
+            report = self._send(cmd, waypoint)
+            reports.append(report)
+            if report.get("ended") or report.get("attempt_ended") or self.episode_finished:
+                stopped = f"waypoint {index + 1} ended the attempt"
+            elif report.get("ok") is False:
+                stopped = f"waypoint {index + 1} returned an error"
+            elif self.style == "v1" and report.get("reached") is False:
+                stopped = f"waypoint {index + 1} was not reached"
+            if stopped:
+                break
+        result: dict[str, Any] = {"waypoints_requested": len(waypoints), "waypoints_executed": len(reports),
+                                  "reports": reports}
+        if stopped and len(reports) < len(waypoints):
+            result["stopped_early"] = f"{stopped}; the remaining {len(waypoints) - len(reports)} waypoint(s) were not sent"
+        return result
+
+    def return_home(self) -> dict[str, Any]:
+        # The robot server resets the scene between attempts; there is no separate homing here.
+        return {"skipped": "simulated robot: the robot server owns resets"}
+
+    def cancel(self) -> None:
+        pass
+
+    def resume(self) -> None:
+        pass
+
+    def close(self) -> None:
+        pass
+
+
+class LffBenchCameras:
+    """CameraSet/RunVideo stand-in: the "fresh snapshot" is the image pair of the latest server reply."""
+
+    def __init__(self, robot: LffBenchSimRobot, width: int = 512, height: int = 512,
+                 log_dir: str | None = None) -> None:
+        self.robot = robot
+        self.width, self.height = width, height
+        self.log_images = os.path.join(log_dir, "images") if log_dir else None
+
+    def snapshot(self, after: float | None = None, timeout: float | None = None) -> dict[str, SimImage]:
+        images: dict[str, SimImage] = {}
+        for path in self.robot.latest_images:
+            base = os.path.basename(path)
+            name = next((camera for camera in CAMERAS if base.endswith(f"_{camera}.jpg")), base)
+            with open(path, "rb") as stream:
+                data = stream.read()
+            images[name] = SimImage(name=name, data=data, mime_type="image/jpeg", width=self.width,
+                                    height=self.height, captured_at=os.path.getmtime(path), source_path=path,
+                                    log_copy=self._log_copy(base, data))
+        if not images:
+            raise RuntimeError("the robot server has not returned any camera images yet")
+        return images
+
+    def _log_copy(self, base: str, data: bytes) -> str | None:
+        """robot_server copies obs/<name> to <LOG>/images/a<attempt>_<name>; find the identical copy."""
+        if not self.log_images or not os.path.isdir(self.log_images):
+            return None
+        for candidate in sorted(glob.glob(os.path.join(self.log_images, f"*_{base}")), reverse=True):
+            try:
+                with open(candidate, "rb") as stream:
+                    if stream.read() == data:
+                        return candidate
+            except OSError:
+                continue
+        return None
+
+    def describe(self, images: dict[str, Any] | None = None) -> list[dict[str, Any]]:
+        names = list(images) if images else list(CAMERAS)
+        return [{"name": name, "width": self.width, "height": self.height} for name in names]
+
+    def stop(self) -> dict[str, Any]:
+        return {}
+
+    def close(self) -> None:
+        pass
+
+
+def _finite(value: Any, where: str) -> float:
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
+        raise ValueError(f"{where} must be a finite number")
+    return float(value)
+
+
+def _eef_target(value: Any, where: str) -> dict[str, Any]:
+    """v2 move_eef arguments; null fields are left out (the server keeps their current value)."""
+    if not isinstance(value, dict):
+        raise ValueError(f"{where} must be an object with x, y, z, yaw, gripper, speed")
+    unknown = set(value) - set(V2_TARGET_KEYS)
+    if unknown:
+        raise ValueError(f"{where} has unknown fields: {sorted(unknown)}")
+    args: dict[str, Any] = {}
+    for key in ("x", "y", "z", "yaw", "speed"):
+        if value.get(key) is not None:
+            args[key] = _finite(value[key], f"{where}.{key}")
+    gripper = value.get("gripper")
+    if gripper is not None:
+        if gripper not in ("open", "close"):
+            raise ValueError(f'{where}.gripper must be "open", "close" or null')
+        args["gripper"] = gripper
+    return args
+
+
+def _waypoint(value: Any, where: str) -> dict[str, Any]:
+    """v1 move_to arguments."""
+    if not isinstance(value, dict):
+        raise ValueError(f"{where} must be an object with x, y, z, yaw, speed")
+    unknown = set(value) - {"x", "y", "z", "yaw", "speed"}
+    if unknown:
+        raise ValueError(f"{where} has unknown fields: {sorted(unknown)}")
+    args: dict[str, Any] = {key: _finite(value.get(key), f"{where}.{key}") for key in ("x", "y", "z", "yaw")}
+    if value.get("speed") is not None:
+        args["speed"] = _finite(value["speed"], f"{where}.speed")
+    return args
+
+
+def _text(value: Any, where: str) -> str:
+    if not isinstance(value, str):
+        raise ValueError(f"{where} must be a string")
+    return value
