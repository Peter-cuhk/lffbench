# Copy to .env (git-ignored) and fill in. Read by scripts/gpt_batch.py, scripts/check_setup.py, rpent_player.sh and
# gptpolicy_player.sh; or export the same variables in your shell instead.
OPENAI_API_KEY=sk-...
# Optional: an OpenAI-compatible gateway / relay; leave unset for api.openai.com
# OPENAI_BASE_URL=https://your-gateway.example.com/v1
# Optional: CA bundle, if your proxy's certificate is not in the default bundle
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
