# Copy to .env (git-ignored) and fill in the key(s) for the provider you use; or export the same variables in your
# shell instead. Read by scripts/api_player.py / api_batch.py (all providers), scripts/check_setup.py --api (OpenAI),
# scripts/gpt_batch.py, rpent_player.sh and gptpolicy_player.sh. See RUN_WITH_YOUR_API.md.

# --provider openai (Responses API)
OPENAI_API_KEY=sk-...
# Optional: an OpenAI-compatible gateway / relay; leave unset for api.openai.com
# OPENAI_BASE_URL=https://your-gateway.example.com/v1

# --provider anthropic (Messages API)
# ANTHROPIC_API_KEY=...
# ANTHROPIC_BASE_URL=https://your-gateway.example.com

# --provider gemini
# GEMINI_API_KEY=...

# --provider chat (any OpenAI-compatible Chat Completions endpoint: vLLM, SGLang, xAI, ...)
# LFF_CHAT_BASE_URL=http://localhost:8000/v1
# LFF_CHAT_API_KEY=...

# Optional: CA bundle, if your proxy's certificate is not in the default bundle
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
